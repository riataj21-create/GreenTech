# GreenTech Configuration Template
# Copy this file to .env and fill in your API key

# === AI PROVIDER CONFIGURATION ===

# Option 1: OpenRouter (Recommended - Free tier available)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Option 2: Gemini (Google AI)  
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# AI Provider selection: "openrouter" (default) or "gemini"
# The system will automatically fallback to available provider
AI_PROVIDER=openrouter

# === AVAILABLE MODELS ===

# OpenRouter Models (see https://openrouter.ai/models):
#   openrouter/free          - Free tier model
#   anthropic/claude-3-haiku - Fast and cost-effective
#   meta-llama/llama-3-8b    - Good balance of performance/cost
#   openai/gpt-3.5-turbo     - OpenAI's GPT-3.5

# Gemini Models (see https://ai.google.dev/gemini-api/docs/models):
#   gemini-3.7-flash     - Latest, most capable Flash model
#   gemini-3.6-flash     - Previous generation Flash (default) 
#   gemini-3.5-flash     - Older Flash model
#   gemini-2.5-flash     - Fast and cost-effective
#   gemini-2.5-pro       - Most advanced reasoning (higher cost)