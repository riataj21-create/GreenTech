# ── GreenTech Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.

# ── Groq (primary — fastest text advice + audio transcription) ────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo

# ── Google Gemini (vision + fallback text) ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── OpenRouter (fallback text + vision) ──────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ── Cloudflare Workers AI (free vision — 10,000 req/day) ─────────────────────
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# ── AI Provider priority: groq → openrouter → gemini ─────────────────────────
AI_PROVIDER=groq

# ── Weather API (OpenWeatherMap — free tier) ──────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_CITY=Madanapalle
WEATHER_COUNTRY_CODE=IN
